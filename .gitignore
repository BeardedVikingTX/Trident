# --- Secrets (NEVER commit these) ---
.env
.env.*
!.env.example
env_example
*.pem
*.key
credentials.json
service-account*.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
